# Compose reads .env. The Python CLI reads process environment variables only.
OPSDESK_ENV=synthetic
POSTGRES_DB=opsdesk_lab
POSTGRES_USER=opsdesk_lab
POSTGRES_PORT=55432
# Set a disposable local password; never use a production credential.
POSTGRES_PASSWORD=
# Explicit destructive-sandbox opt-in, still restricted to approved database names.
OPSDESK_ALLOW_SANDBOX=1
# Set this in your shell, with the matching URL-encoded local password.
OPSDESK_DATABASE_URL=
# Optional real-model CLI only (--provider openai --model ID --live).
# Fake demos, tests and CI never need a key. Leave empty unless explicitly opting in.
OPENAI_API_KEY=
# Trusted stdio launch only; Python reads these from the shell, not this file.
OPSDESK_MCP_RUN_ID=
OPSDESK_MCP_ACTOR_ID=
OPSDESK_MCP_TENANT_ID=
# Generate 32 random bytes as lowercase hex in the trusted host; never commit it.
OPSDESK_MCP_SIGNING_KEY=
